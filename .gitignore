node_modules/
.vercel/
# Machine-local Claude state stays out, but the SKILLS must ship: the art
# bible is what stops floor 9 belonging to a different game than floor 1, and
# a campaign that assumes every session is a stranger cannot keep its own
# rulebook in an ignored folder.
.claude/*
!.claude/skills/
.DS_Store
Thumbs.db
*.log

# Obsidian per-machine UI state (pane layout, open files)
docs/.obsidian/workspace.json

# build output — never commit the zip, it is 13MB of audio
dist/
*.zip

# desktop wrapper: deps, the staged copy of the game, and the packaged exe
desktop/node_modules/
desktop/game/
desktop/release/

# the only folder anyone uploads from
release/
